# HEARTS360 Toolkit — local configuration.
#
#   cp .env.example .env
#
# Every value below is OPTIONAL. Leave the file untouched (or delete it) and the
# stack behaves exactly as it did before this file existed. Docker Compose reads
# `.env` from the project root automatically.
#
# Prefer the helper scripts if you just want it to work:
#   Linux / macOS : ./scripts/heart360-up.sh
#   Windows       : .\scripts\heart360-up.ps1
# They probe the host, pick free ports, write them here, and start the stack.


# =============================================================================
# 1. HOST PORTS
# =============================================================================
# Change these when something else already owns the default port.
# Common collisions: 3000 (Node/React dev servers, Gitea), 5432 (a local
# PostgreSQL install), 8080 (Tomcat, Jenkins, Spring Boot), 5050 (Kubeflow,
# other pgAdmin instances).
#
# Only the HOST side changes — the containers keep talking to each other on
# their internal ports, so nothing else needs adjusting.

HEART360_GRAFANA_PORT=3000
HEART360_POSTGRES_PORT=5432
HEART360_FILEBROWSER_PORT=8080
HEART360_PGADMIN_PORT=5050

# Interface the published ports bind to.
#   0.0.0.0   — reachable from the network (default, required for the EC2 deploy)
#   127.0.0.1 — reachable only from this machine (recommended for laptops and
#               for any host that has not changed the default passwords)
HEART360_BIND_ADDRESS=0.0.0.0

# Public URL Grafana should use when building links. Set this when Grafana is
# published on a non-default port or sits behind a reverse proxy.
# HEART360_GRAFANA_ROOT_URL=http://localhost:3000/


# =============================================================================
# 2. RUNNING MORE THAN ONE STACK ON ONE HOST
# =============================================================================
# Container names are fixed by default (grafana, postgres, ...), so a second
# copy of the stack collides on names even if the ports differ. Set a distinct
# project name and container names per instance.
#
# COMPOSE_PROJECT_NAME=h360tk_demo
# HEART360_GRAFANA_CONTAINER=h360tk_demo_grafana
# HEART360_POSTGRES_CONTAINER=h360tk_demo_postgres
# HEART360_PGADMIN_CONTAINER=h360tk_demo_pgadmin
# HEART360_FILEBROWSER_CONTAINER=h360tk_demo_filebrowser
# HEART360_FILEPROC_CONTAINER=h360tk_demo_fileproc
#
# NOTE: changing COMPOSE_PROJECT_NAME on an existing deployment points Compose
# at a different set of named volumes, so pgAdmin's saved state starts empty.


# =============================================================================
# 3. CORPORATE PROXY / TLS INTERCEPTION
# =============================================================================
# Symptoms this section fixes:
#
#   SSLError(1, '[SSL: SSLV3_ALERT_HANDSHAKE_FAILURE] ssl/tls alert handshake failure')
#   SSLError(1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed')
#   Could not fetch URL https://pypi.org/simple/... skipping
#   failed to solve: failed to do request ... tls: handshake failure
#
# Full decision tree: docs/ports-and-proxy.md

# --- 3a. Route egress through the proxy ------------------------------------
# This alone fixes most SSLV3_ALERT_HANDSHAKE_FAILURE cases: the failure is
# usually a firewall resetting a DIRECT TLS connection, not a real TLS problem.
# Forcing a CONNECT tunnel through the proxy avoids it.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,grafana,pgadmin,filebrowser-quantum,file-upload-trigger

# --- 3b. Trust the interception CA -----------------------------------------
# Fixes CERTIFICATE_VERIFY_FAILED. No variable needed: drop the *.crt / *.pem
# root CA files into ./certs/ and rebuild. See certs/README.md.

# --- 3c. Use an internal package mirror ------------------------------------
# PIP_INDEX_URL=https://nexus.example.com/repository/pypi/simple
# PIP_TRUSTED_HOST=nexus.example.com
# HEART360_PG_CRON_REPO=https://gitmirror.example.com/citusdata/pg_cron.git
# HEART360_GF_PLUGIN_REPO=https://grafana-mirror.example.com

# --- 3d. Relax transport security (last resort, read the docs first) --------
# apk over plain HTTP. Alpine packages stay signature-verified, so integrity is
# preserved; only confidentiality of the download is lost.
# HEART360_APK_INSECURE_HTTP=true
#
# Allow OpenSSL to negotiate older protocol versions and cipher suites. Use
# when the proxy itself cannot complete a modern handshake.
# HEART360_TLS_LEGACY=true
#
# Skip TLS verification for pip / grafana-cli / git. This disables authenticity
# checks on downloaded code — only acceptable on a trusted network while you
# obtain the proper CA for ./certs. Never leave this on.
# HEART360_TLS_INSECURE=true

# --- 3e. No egress at all (air-gapped) -------------------------------------
# Pre-download wheels into ./vendor/wheels (see vendor/wheels/README.md), then:
# HEART360_GF_INSTALL_PLUGINS=
# HEART360_SKIP_BOOTSTRAP=false
#
# Make a failed dependency bootstrap fatal instead of starting a watcher that
# silently cannot ingest files:
# HEART360_REQUIRE_DEPS=true


# =============================================================================
# 4. CREDENTIALS
# =============================================================================
# The defaults below are the values that were previously hard-coded in this
# public repository, kept only so existing deployments keep working.
#
# THEY ARE PUBLIC. Rotate every one of them before exposing this stack to any
# network, and see docs/ports-and-proxy.md#hardening for the rotation steps
# (the PostgreSQL passwords are also written by pg_init_scripts/00_schemas.sql,
# so they must be changed in both places on a fresh volume).

# HEART360_DB_NAME=heart360tk_database
# HEART360_DB_ROOT_USER=h360tk_root
# HEART360_DB_ROOT_PASSWORD=change-me
# HEART360_DB_APP_USER=heart360tk
# HEART360_DB_APP_PASSWORD=change-me
# HEART360_DB_GRAFANA_PASSWORD=change-me
# HEART360_PGADMIN_EMAIL=admin@heart360.org
# HEART360_PGADMIN_PASSWORD=change-me
# HEART360_FILEBROWSER_PASSWORD=change-me


# =============================================================================
# 5. IMAGE OVERRIDES
# =============================================================================
# Point at an internal registry mirror when Docker Hub is unreachable.
# HEART360_PGADMIN_IMAGE=registry.example.com/dpage/pgadmin4:9.14
# HEART360_FILEBROWSER_IMAGE=registry.example.com/gtstef/filebrowser:stable-slim
# HEART360_FILEPROC_IMAGE=registry.example.com/devodev/inotify
